# Copy to .env and fill in your own values. Never commit .env.
MYSQL_DATABASE=blog_db
MYSQL_USER=blog_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Only used to bootstrap an empty admin_users table.
BLOG_ADMIN_USERNAME=
BLOG_ADMIN_PASSWORD=

# Optional: AI chat returns an unconfigured message when this is empty.
DASHSCOPE_API_KEY=
